# Boutique WhatsApp number in international format without "+" (used by lib/whatsapp.ts).
NEXT_PUBLIC_WHATSAPP_NUMBER=923713078774
# Public site URL used in WhatsApp messages and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (leave blank to run the storefront on the built-in mock catalogue)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used for media uploads and the seed script. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed to sign in to /admin
ADMIN_EMAILS=owner@example.com
